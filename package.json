{
  "name": "@smalltailqwq/dsh-perf-flow",
  "version": "0.0.2",
  "description": "Reduce rendering work for off-screen conversation items.",
  "icon": "./icon.svg",
  "type": "module",
  "scripts": {
    "sync-css": "node scripts/sync-css.mjs",
    "check": "node scripts/sync-css.mjs --check"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Small-tailqwq/dsh-perf-flow.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
